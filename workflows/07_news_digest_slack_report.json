    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\n\nconst news = $input.all();\nconst blocks = [];\n\nfor (const item of news) {\n  blocks.push({\n    type: \"section\",\n    text: {\n      type: \"mrkdwn\",\n      text: `*<${item.json.url}|${item.json.title}>*\\n${item.json.content}`\n    }\n  });\n  blocks.push({type: 'divider'});\n}\n\nreturn {json: {blocks}}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        320
      ],
